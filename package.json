{
  "name": "courses-ecom",
  "version": "0.101.25",
  "private": true,
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "build": "next build",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 next start",
    "lint": "next lint",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run lint:check && npm run build",
    "prebuild": "node ./scripts/set-publish-date.js",
    "postinstall": "node ./scripts/postinstall.js",
    "deploy:dev": "export COMPOSE_PROJECT_NAME=courses && lib/ecom/scripts/deploy dev",
    "deploy:prod": "export COMPOSE_PROJECT_NAME=courses && lib/ecom/scripts/deploy prod"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "framer-motion": "^12.34.0",
    "gsap": "^3.12.2",
    "html-react-parser": "^5.2.5",
    "konva": "^10.2.0",
    "lucide-react": "^0.577.0",
    "serverless-ecom-nextjs": "github:dinesh36/serverless-ecom-nextjs#v1.123.25",
    "mr-ecom-ui": "github:dinesh36/mr-ecom-ui#v1.45.17",
    "next": "15.3.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-konva": "^19.2.1",
    "react-konva-utils": "^2.0.0",
    "react-redux": "^9.2.0",
    "react-rnd": "^10.5.2"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-onboarding": "^8.6.15",
    "@storybook/experimental-addon-test": "^8.6.15",
    "@storybook/nextjs": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@tailwindcss/postcss": "^4",
    "@tattva-design/eslint": "^0.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "globals": "^16.0.0",
    "prettier": "3.3.3",
    "react-toastify": "^11.0.5",
    "sass": "^1.86.3",
    "storybook": "^8.6.15",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
