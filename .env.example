# Copy this file to `.env.local` and set the values for your store. Everything here is a dummy value.

# The storefront's own address (locally http://localhost:3000, deployed the tenant's domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The backend the storefront talks to through `/api/*` (locally the backend on its own port, or a deployed tenant's domain)
NEXT_ECOM_BACKEND_URL=http://localhost:3001

# The tenant's key in the backend (`ecomTenants.tenants`). Needed when the backend is a local server: it cannot find the tenant from
# the host (localhost), so the storefront sends this key. A deployed backend finds the tenant from its domain and never gets it.
NEXT_PUBLIC_TENANT_KEY=your-tenant-key

# Deploy of the static site to S3 (lib/ecom/scripts/deploy-static-site.js): not secret, the AWS credentials are the CLI profile's
DEPLOY_S3_BUCKET=your-system-dev-your-tenant
DEPLOY_S3_PREFIX=fe-app
DEPLOY_CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXXXXXX
AWS_REGION=ap-south-1
DEPLOY_CLOUDFRONT_KVS_ARN=arn:aws:cloudfront::123456789012:key-value-store/00000000-0000-0000-0000-000000000000
